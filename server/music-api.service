[Unit]
Description=Personal music library API
After=network.target

[Service]
Type=simple
Environment=MUSIC_DIR=/srv/music
Environment=WEB_DIR=/opt/music-server/web
Environment=MUSIC_PORT=8080
Environment=MUSIC_HOST=0.0.0.0
ExecStart=/usr/bin/python3 /opt/music-server/server.py
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
